# Frontend config — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# Vite exposes ONLY variables prefixed VITE_ to client code. SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_URL and the POSTGRES_* set that the Vercel Supabase
# integration writes into .env.local are invisible to this app, whatever they
# are set to. These three names are the entire frontend surface.
#
# Set the same two VITE_ names in Vercel for Production, Preview and Development,
# then redeploy — Vite inlines them at build time, so a dashboard change does
# nothing until the next build.
#
# Careful: `vercel env pull` OVERWRITES .env.local and will drop these lines,
# because Vercel holds no VITE_ variables. If local Supabase stops working right
# after a pull, that is why.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The publishable key (sb_publishable_…) or the legacy anon JWT (eyJ…).
# Project Settings → API Keys.
#
# NEVER put service_role or sb_secret_… here. They bypass Row Level Security,
# and this value ships inside the browser bundle. The publishable key is safe
# because every policy is auth.uid() = user_id: on its own it grants nothing.
VITE_SUPABASE_KEY=

# Optional. The Flask backend's base URL. Leave blank unless you are running it.
#
# Blank means the app runs its own diagnosis and level generation on-device
# (src/app/lib/adaptiveEngine.ts) and builds the progress report locally, which
# is how the hosted app works. Setting this to an unreachable host costs an 8s
# timeout before every level, so leave it empty rather than guessing.
VITE_API_URL=

# Backend config — copy to backend/.env and fill in.
#
#   cp backend/.env.example backend/.env
#
# Needed only if you are running the Flask server. The hosted app does not use
# it: /analyze_session is a convenience, and with no VITE_API_URL set the client
# runs the identical rules on-device.

# Supabase project URL and key.
#
# Unprefixed here, not VITE_ — this file is read by Python, never by the browser.
# The server is stateless (it reads no database and writes none), so these are
# used only by the retired /progress_report route, which app.py no longer
# registers. Leave them blank and the server still starts and works.
SUPABASE_URL=
SUPABASE_KEY=

# Gemini API key, from https://aistudio.google.com/apikey
#
# Personalises distractor choice and writes the teacher-facing prose. Without it
# the LLM router falls through to deterministic rules, which is the same path the
# hosted app takes — so a missing key degrades wording, never the adaptation.
GEMINI_API_KEY=

# Optional: Vertex AI instead of the Gemini API. Only read if PROJECT is set.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

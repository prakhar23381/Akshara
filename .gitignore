# ── Frontend ──────────────────────────────────────────────
node_modules/
dist/
.env
.env.local
.env.*.local

# ── Backend ───────────────────────────────────────────────
backend/.env
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
*.egg-info/
.venv/
venv/

# ── OS / Editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.vercel
.env*

# ── Env ───────────────────────────────────────────────────
# `.env*` above also catches .env.example, which defeats the point of having a
# template. Negations must come after the pattern they undo.
!.env.example
!backend/.env.example
